# =============================================================================
# Job-Pilot-AI — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
APP_NAME=Job-Pilot-AI
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","chrome-extension://"]

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Host:     db.zjcaucxnkysyrhuwaevv.supabase.co
# Port:     5432
# Database: postgres
# User:     postgres
# Password: <your Supabase DB password>
#
# Async driver — used by FastAPI / SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.zjcaucxnkysyrhuwaevv.supabase.co:5432/postgres?ssl=require
#
# Sync driver — used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.zjcaucxnkysyrhuwaevv.supabase.co:5432/postgres?sslmode=require

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── JWT (RS256) ───────────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM (Google Gemini) ───────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# ── Gmail OAuth2 ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/email/callback

# ── Email Sending (for reminders) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@jobpilot.ai

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
